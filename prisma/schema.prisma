generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Empreendimento {
  id               String   @id @default(cuid())
  nome             String
  percentualSocio  Float    @default(0)
  tipoParticipacao String   @default("societario")
  descricao        String?
  cor              String   @default("#3b82f6")
  arquivado        Boolean  @default(false)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
  lotes            Lote[]
  contasBancarias  ContaBancaria[]
  prestacoes       PrestacaoDeContas[]

  @@map("empreendimentos")
}

model Lote {
  id               String           @id @default(cuid())
  empreendimentoId String
  quadra           String
  numero           String
  identificacao    String
  areaM2           Float?
  tipoPropriedade  TipoPropriedade  @default(SOCIETARIO)
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt
  empreendimento   Empreendimento   @relation(fields: [empreendimentoId], references: [id])
  contrato         Contrato?

  @@unique([empreendimentoId, quadra, numero])
  @@map("lotes")
}

enum TipoPropriedade {
  SOCIETARIO
  PESSOAL
}

model Contrato {
  id                     String         @id @default(cuid())
  loteId                 String         @unique
  nomeComprador          String
  cpfComprador           String?
  telefoneComprador      String?
  emailComprador         String?
  valorTotal             Decimal        @db.Decimal(12, 2)
  valorEntrada           Decimal        @default(0) @db.Decimal(12, 2)
  dataAssinatura         DateTime
  dataVencimento1Parcela DateTime
  quantidadeParcelas     Int
  valorParcela           Decimal        @db.Decimal(12, 2)
  diaVencimento          Int
  status                 StatusContrato @default(EM_DIA)
  observacoes            String?
  criadoEm               DateTime       @default(now())
  atualizadoEm           DateTime       @updatedAt
  lote                   Lote           @relation(fields: [loteId], references: [id])
  parcelas               Parcela[]

  @@map("contratos")
}

enum StatusContrato {
  EM_DIA
  INADIMPLENTE
  QUITADO
  CANCELADO
}

model Parcela {
  id              String        @id @default(cuid())
  contratoId      String
  numeroParcela   Int
  valorOriginal   Decimal       @db.Decimal(12, 2)
  valorCorrigido  Decimal?      @db.Decimal(12, 2)
  dataVencimento  DateTime
  dataRecebimento DateTime?
  valorRecebido   Decimal?      @db.Decimal(12, 2)
  status          StatusParcela @default(PENDENTE)
  transacaoId     String?
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  contrato        Contrato      @relation(fields: [contratoId], references: [id])
  transacao       Transacao?    @relation(fields: [transacaoId], references: [id])

  @@unique([contratoId, numeroParcela])
  @@map("parcelas")
}

enum StatusParcela {
  PENDENTE
  RECEBIDA
  ATRASADA
  BAIXA_AUTOMATICA
  BAIXA_MANUAL
}

model ContaBancaria {
  id                  String          @id @default(cuid())
  empreendimentoId    String?
  apelido             String
  banco               String          @default("Sicoob")
  agencia             String
  conta               String
  tipoConta           TipoConta       @default(CORRENTE)
  accessToken         String?         @db.Text
  refreshToken        String?         @db.Text
  tokenExpiresAt      DateTime?
  consentimentoId     String?
  ultimaSincronizacao DateTime?
  ativa               Boolean         @default(true)
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  empreendimento      Empreendimento? @relation(fields: [empreendimentoId], references: [id])
  transacoes          Transacao[]

  @@map("contas_bancarias")
}

enum TipoConta {
  CORRENTE
  POUPANCA
}

model Transacao {
  id                      String             @id @default(cuid())
  contaBancariaId         String
  transacaoExternaId      String?
  data                    DateTime
  descricao               String
  valor                   Decimal            @db.Decimal(12, 2)
  tipo                    TipoTransacao
  categoria               CategoriaTransacao @default(OUTROS)
  identificadaComoRepasse Boolean            @default(false)
  prestacaoDeContasId     String?
  criadoEm                DateTime           @default(now())
  contaBancaria           ContaBancaria      @relation(fields: [contaBancariaId], references: [id])
  prestacaoDeContas       PrestacaoDeContas? @relation(fields: [prestacaoDeContasId], references: [id])
  parcelas                Parcela[]

  @@unique([contaBancariaId, transacaoExternaId])
  @@map("transacoes")
}

enum TipoTransacao {
  CREDITO
  DEBITO
}

enum CategoriaTransacao {
  REPASSE_QUALITY
  OUTROS
}

model PrestacaoDeContas {
  id                   String            @id @default(cuid())
  empreendimentoId     String
  mesReferencia        Int
  anoReferencia        Int
  dataEnvio            DateTime
  dataImportacao       DateTime          @default(now())
  arquivoNome          String
  arquivoUrl           String?
  totalRecebidoQuality Decimal           @db.Decimal(12, 2)
  totalRecebidoExtrato Decimal?          @db.Decimal(12, 2)
  statusConciliacao    StatusConciliacao @default(PENDENTE)
  criadoEm             DateTime          @default(now())
  atualizadoEm         DateTime          @updatedAt
  empreendimento       Empreendimento    @relation(fields: [empreendimentoId], references: [id])
  itens                ItemPrestacao[]
  divergencias         Divergencia[]
  transacoes           Transacao[]

  @@unique([empreendimentoId, mesReferencia, anoReferencia])
  @@map("prestacoes_de_contas")
}

enum StatusConciliacao {
  PENDENTE
  CONCILIADO_OK
  CONCILIADO_DIVERGENCIAS
  EM_ANALISE
}

model ItemPrestacao {
  id                  String            @id @default(cuid())
  prestacaoDeContasId String
  loteIdentificacao   String
  nomeComprador       String?
  valorRecebido       Decimal           @db.Decimal(12, 2)
  dataRecebimento     DateTime
  numeroParcela       Int?
  statusReportado     String?
  parcelaId           String?
  criadoEm            DateTime          @default(now())
  prestacaoDeContas   PrestacaoDeContas @relation(fields: [prestacaoDeContasId], references: [id])

  @@map("itens_prestacao")
}

model Divergencia {
  id                  String            @id @default(cuid())
  prestacaoDeContasId String
  tipo                TipoDivergencia
  severidade          Severidade
  descricao           String
  valorEsperado       Decimal?          @db.Decimal(12, 2)
  valorEncontrado     Decimal?          @db.Decimal(12, 2)
  loteIdentificacao   String?
  resolucao           String?
  resolvida           Boolean           @default(false)
  criadoEm            DateTime          @default(now())
  atualizadoEm        DateTime          @updatedAt
  prestacaoDeContas   PrestacaoDeContas @relation(fields: [prestacaoDeContasId], references: [id])

  @@map("divergencias")
}

enum TipoDivergencia {
  VALOR_DIFERENTE
  PARCELA_NAO_ENCONTRADA
  LOTE_AUSENTE
  INADIMPLENCIA_DIVERGENTE
  CREDITO_SEM_ORIGEM
}

enum Severidade {
  CRITICO
  ATENCAO
  INFO
}

model Alerta {
  id             String     @id @default(cuid())
  tipo           TipoAlerta
  titulo         String
  mensagem       String
  loteId         String?
  parcelaId      String?
  emailEnviado   Boolean    @default(false)
  emailEnviadoEm DateTime?
  lido           Boolean    @default(false)
  criadoEm       DateTime   @default(now())

  @@map("alertas")
}

enum TipoAlerta {
  PARCELA_VENCIDA
  INADIMPLENCIA_NOVA
  DIVERGENCIA_CONCILIACAO
  REPASSE_RECEBIDO
}

model Configuracao {
  id                   String   @id @default(cuid())
  emailNotificacoes    String
  diasToleranciaAtraso Int      @default(5)
  sicoobClientId       String?
  sicoobClientSecret   String?  @db.Text
  sicoobRedirectUri    String?
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@map("configuracoes")
}
